NODE_ENV=development
PORT=4000

# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
# Example: postgresql://myuser:mypassword@localhost:5432/mydatabase
DATABASE_URL=postgresql://username:password@host:port/database

# Must be long/random (>= 32 chars). Generate a secure secret.
# You can use: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-here-at-least-32-characters
JWT_EXPIRES_IN=8h

# React dev server origin (Vite default)
CORS_ORIGIN=http://localhost:5173

