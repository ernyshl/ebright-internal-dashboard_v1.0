NODE_ENV=development
PORT=4000

# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
# Example: postgresql://myuser:mypassword@localhost:5432/mydatabase
DATABASE_URL=postgresql://username:password@host:port/database

# Inventory PostgreSQL connection (REQUIRED at boot — see backend/src/env.js + db.js)
# Used by Finance dashboard's inventory query (backend/src/routes/finance.js).
# If you don't have a separate inventory DB, point this at DATABASE_URL — server will boot
# but Finance dashboard inventory query will fail at runtime.
INV_DATABASE_URL=postgresql://username:password@host:port/database

# Active student tables — defaults to production tables in code; override on staging/test
# Allowed values: studentrecords | studentrecords_testing
# Allowed values: archived_students | archived_students_testing
STUDENT_TABLE=studentrecords
ARCHIVED_TABLE=archived_students

# IMPORTANT: Must be long/random (>= 32 chars). Generate with:
#   openssl rand -base64 64
# NEVER use the default value below in production!
JWT_SECRET=CHANGE-ME-generate-with-openssl-rand-base64-64
JWT_EXPIRES_IN=8h

# Session Security
# Shorter session times are more secure for production
# Recommended: 1h for high-security environments
# JWT_EXPIRES_IN=1h

# React dev server origin (Vite default)
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
AUTH_RATELIMIT_MAX=100

# Meta / TikTok ad account IDs (Optional — used by marketing performance endpoint)
# These are the account_id values stored in the meta_spend table
META_MAIN_FB_ID=act_xxxxxxxxxxxxxxxxx
META_TT_ID=xxxxxxxxxxxxxxxxx
META_SARA_ID=act_xxxxxxxxxxxxxxxxx
META_ONLINE_ID=act_xxxxxxxxxxxxxxxxx

# Google Ads API Configuration (Optional)
# Get these from Google Ads API setup: https://developers.google.com/google-ads/api
# Only required if you want to fetch data from Google Ads
GOOGLE_DEVELOPER_TOKEN=your-developer-token-here
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret-here
GOOGLE_REFRESH_TOKEN=your-refresh-token-here
GOOGLE_LOGIN_CUSTOMER_ID=your-customer-id
GOOGLE_ADS_ID=your-google-ads-id

# Telegram bot (required only if using the bot / alerts)
# Get token from @BotFather. Rotate immediately if it ever leaks into git.
TELEGRAM_BOT_TOKEN=
# Allowlist of chat IDs permitted to interact with the webhook (slash commands).
# Comma-separated, no spaces.
TELEGRAM_ALLOWED_CHATS=
# Recipients for the scheduled leads report (telegram-report.sh, 6x/day).
# Comma-separated; broadcast to every ID. Optional — falls back to
# TELEGRAM_ALLOWED_CHATS if unset.
TELEGRAM_REPORT_CHATS=
# Recipients for ops alerts (meta-alert.sh + future sync/health alerts).
# Comma-separated; keep this narrow to avoid alert fatigue. Optional — falls
# back to the first ID in TELEGRAM_ALLOWED_CHATS if unset.
TELEGRAM_ALERT_CHATS=

